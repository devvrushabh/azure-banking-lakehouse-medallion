{
	"name": "Banking_Master_Orchestrator",
	"properties": {
		"description": "End-to-end master orchestrator coordinating Bronze ingestion, Silver cleansing/SCD2, and Gold aggregations.",
		"activities": [
			{
				"name": "Check_Run_Type",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.RunType, 'Full')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Exec_Bronze_Incremental_Load",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Banking_Incremenal_Pipeline",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Exec_Bronze_Full_Load",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Banking_Full_Load_Pipeline",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true
							}
						}
					]
				}
			},
			{
				"name": "Execute_Silver_Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Check_Run_Type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "Silver_Pipeline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Execute_Gold_Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Execute_Silver_Pipeline",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "Gold_Pipeline",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			}
		],
		"parameters": {
			"RunType": {
				"type": "string",
				"defaultValue": "Incremental"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-05T23:44:43Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}